{
  "name": "@intent-wallet/api",
  "version": "0.1.0",
  "private": true,
  "description": "Intent Wallet API (Fastify): SIWE/JWT auth, intent planning + authorize/execute, portfolio balances + insights, ENS/gas/history, DEX quotes (Jupiter/Uniswap/GIWA AMM), and OFAC sanctions screening, on the config/logging/health/OpenAPI foundation.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch --tsconfig ../../tsconfig.base.json src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "@fastify/helmet": "^13",
    "@fastify/rate-limit": "^10",
    "@noble/hashes": "^1.7.0",
    "@intent-wallet/chains": "workspace:^",
    "@intent-wallet/config": "workspace:*",
    "@intent-wallet/core": "workspace:*",
    "@intent-wallet/events": "workspace:*",
    "@intent-wallet/intelligence": "workspace:^",
    "@intent-wallet/intents": "workspace:^",
    "@intent-wallet/observability": "workspace:*",
    "@intent-wallet/portfolio": "workspace:*",
    "@intent-wallet/risk": "workspace:^",
    "@intent-wallet/runtime": "workspace:*",
    "fastify": "^5.2.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@intent-wallet/sdk": "workspace:^",
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "ioredis-mock": "^8.13.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
