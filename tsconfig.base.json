{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@intent-wallet/core": ["packages/core/src/index.ts"],
      "@intent-wallet/chains": ["packages/chains/src/index.ts"],
      "@intent-wallet/config": ["packages/config/src/index.ts"],
      "@intent-wallet/observability": ["packages/observability/src/index.ts"],
      "@intent-wallet/events": ["packages/events/src/index.ts"],
      "@intent-wallet/identity": ["packages/identity/src/index.ts"],
      "@intent-wallet/portfolio": ["packages/portfolio/src/index.ts"],
      "@intent-wallet/intelligence": ["packages/intelligence/src/index.ts"],
      "@intent-wallet/intents": ["packages/intents/src/index.ts"],
      "@intent-wallet/execution": ["packages/execution/src/index.ts"],
      "@intent-wallet/providers": ["packages/providers/src/index.ts"],
      "@intent-wallet/router": ["packages/router/src/index.ts"],
      "@intent-wallet/risk": ["packages/risk/src/index.ts"],
      "@intent-wallet/policy": ["packages/policy/src/index.ts"],
      "@intent-wallet/copilot": ["packages/copilot/src/index.ts"],
      "@intent-wallet/automation": ["packages/automation/src/index.ts"],
      "@intent-wallet/settlement": ["packages/settlement/src/index.ts"],
      "@intent-wallet/solver": ["packages/solver/src/index.ts"],
      "@intent-wallet/reliability": ["packages/reliability/src/index.ts"],
      "@intent-wallet/scale": ["packages/scale/src/index.ts"],
      "@intent-wallet/compliance": ["packages/compliance/src/index.ts"],
      "@intent-wallet/plugins": ["packages/plugins/src/index.ts"],
      "@intent-wallet/runtime": ["packages/runtime/src/index.ts"],
      "@intent-wallet/gas": ["packages/gas/src/index.ts"],
      "@intent-wallet/capabilities": ["packages/capabilities/src/index.ts"],
      "@intent-wallet/sdk": ["packages/sdk/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
