{
  "name": "intent-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Native Universal Intent Wallet — monorepo",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "health": "node scripts/health.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.19.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@<=6.4.2": ">=6.4.3",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "find-my-way@<=9.6.0": ">=9.7.0",
      "postcss@<=8.5.17": ">=8.5.18",
      "brace-expansion@<=5.0.7": ">=5.0.8"
    }
  }
}
